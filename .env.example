# Copy to .env and fill in. Never commit the real .env -- see .gitignore.
#
# None of this is needed for `hindsight demo`, which runs on the bundled
# dataset with no configuration at all.

# --- Public-channel mode (easiest way to analyse a real channel) ---
# An API key from console.cloud.google.com with "YouTube Data API v3" enabled.
# No OAuth consent screen required.
#   hindsight ingest --channel @some_handle
YOUTUBE_API_KEY=

# --- Paths ---
# Where the local catalog cache lives. Safe to delete; `hindsight ingest`
# rebuilds it.
# HINDSIGHT_HOME=.hindsight

# Where reports and experiment manifests are written.
# HINDSIGHT_OUT=out

# Directory tree scanned by `hindsight auth list` for *_token.json files.
# Point this at your channel assets folder if you already have OAuth tokens.
# HINDSIGHT_TOKEN_DIR=.

# OAuth client config, used only by `hindsight auth login`.
# HINDSIGHT_CLIENT_SECRETS=client_secrets.json
